<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_microsoft_365" model="ir.module.category">
        <field name="name">Microsoft 365</field>
        <field name="sequence">35</field>
    </record>

    <record id="res_groups_privilege_microsoft_365" model="res.groups.privilege">
        <field name="name">Gestión documental Microsoft 365</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="module_category_microsoft_365"/>
    </record>

    <record id="group_microsoft_document_user" model="res.groups">
        <field name="name">Usuario documental</field>
        <field name="privilege_id" ref="res_groups_privilege_microsoft_365"/>
        <field name="sequence">10</field>
    </record>

    <record id="group_microsoft_document_editor" model="res.groups">
        <field name="name">Editor documental</field>
        <field name="privilege_id" ref="res_groups_privilege_microsoft_365"/>
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[(4, ref('group_microsoft_document_user'))]"/>
    </record>

    <record id="group_microsoft_document_manager" model="res.groups">
        <field name="name">Gestor documental</field>
        <field name="privilege_id" ref="res_groups_privilege_microsoft_365"/>
        <field name="sequence">30</field>
        <field name="implied_ids" eval="[(4, ref('group_microsoft_document_editor'))]"/>
    </record>

    <record id="group_microsoft_admin" model="res.groups">
        <field name="name">Administrador Microsoft 365</field>
        <field name="privilege_id" ref="res_groups_privilege_microsoft_365"/>
        <field name="sequence">40</field>
        <field name="implied_ids" eval="[(4, ref('group_microsoft_document_manager'))]"/>
    </record>
</odoo>

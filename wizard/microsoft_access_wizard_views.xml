<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_microsoft_access_wizard_form" model="ir.ui.view">
        <field name="name">microsoft.access.wizard.form</field>
        <field name="model">microsoft.access.wizard</field>
        <field name="arch" type="xml">
            <form string="Aprovisionar accesos Microsoft 365">
                <group>
                    <field name="tenant_id"/>
                    <field name="user_ids" widget="many2many_tags"/>
                    <field name="access_role"/>
                </group>
                <group string="Accesos Microsoft">
                    <field name="group_ids" widget="many2many_tags" domain="[('tenant_id', '=', tenant_id)]"/>
                    <field name="location_ids" widget="many2many_tags" domain="[('tenant_id', '=', tenant_id)]"/>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="Registrar y aplicar" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_microsoft_access_wizard" model="ir.actions.act_window">
        <field name="name">Aprovisionar usuarios</field>
        <field name="res_model">microsoft.access.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>

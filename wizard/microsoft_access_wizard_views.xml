<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_microsoft_access_wizard_form" model="ir.ui.view">
        <field name="name">microsoft.access.wizard.form</field>
        <field name="model">microsoft.access.wizard</field>
        <field name="arch" type="xml">
            <form string="Aprovisionar accesos Microsoft 365" create="false" edit="true">
                <sheet>
                    <group>
                        <group string="Configuración del acceso">
                            <field name="tenant_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="user_ids" widget="many2many_tags"
                                   domain="[('share', '=', False), ('active', '=', True)]"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="access_role" widget="radio"/>
                        </group>
                        <group string="Aplicación de permisos">
                            <field name="apply_mode" widget="radio"/>
                            <div class="text-muted" colspan="2">
                                <p>Reemplazar: aplica únicamente los grupos y las ubicaciones seleccionados.</p>
                                <p>Agregar: mantiene los accesos existentes del mismo tenant y añade los nuevos.</p>
                                <p>El rol documental elegido se aplicará a todos los usuarios seleccionados.</p>
                            </div>
                        </group>
                    </group>
                    <group string="Accesos Microsoft">
                        <field name="group_ids" widget="many2many_tags"
                               domain="[('tenant_id', '=', tenant_id)]"
                               options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="location_ids" widget="many2many_tags"
                               domain="[('tenant_id', '=', tenant_id), ('active', '=', True)]"
                               options="{'no_create': True, 'no_create_edit': True}"/>
                    </group>
                    <div class="alert alert-info" role="alert">
                        La aplicación de accesos puede invitar usuarios mediante Microsoft Entra B2B
                        y sincronizar los grupos y bibliotecas seleccionados.
                        Los usuarios invitados deben aceptar la invitación cuando Microsoft lo requiera.
                    </div>
                </sheet>
                <footer>
                    <button name="action_apply" type="object"
                            string="Registrar y aplicar" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_microsoft_access_wizard" model="ir.actions.act_window">
        <field name="name">Aprovisionar usuarios</field>
        <field name="res_model">microsoft.access.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>

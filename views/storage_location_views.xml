<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_microsoft_location_list" model="ir.ui.view">
        <field name="name">microsoft.storage.location.list</field>
        <field name="model">microsoft.storage.location</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="location_type" widget="badge"/>
                <field name="site_id" optional="show"/>
                <field name="library_id" optional="show"/>
                <field name="drive_id" optional="hide"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_microsoft_location_form" model="ir.ui.view">
        <field name="name">microsoft.storage.location.form</field>
        <field name="model">microsoft.storage.location</field>
        <field name="arch" type="xml">
            <form string="Ubicación documental">
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="tenant_id"/>
                            <field name="location_type"/>
                            <field name="site_id" invisible="location_type != 'sharepoint'" domain="[('tenant_id', '=', tenant_id)]"/>
                            <field name="library_id" invisible="location_type != 'sharepoint'" domain="[('site_id', '=', site_id)]"/>
                        </group>
                        <group>
                            <field name="drive_id" placeholder="Vacío para la cuenta OneDrive delegada"/>
                            <field name="web_url" widget="url"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lectores"><field name="reader_user_ids" widget="many2many_tags"/></page>
                        <page string="Editores"><field name="editor_user_ids" widget="many2many_tags"/></page>
                        <page string="Gestores"><field name="manager_user_ids" widget="many2many_tags"/></page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_microsoft_locations" model="ir.actions.act_window">
        <field name="name">Ubicaciones documentales</field>
        <field name="res_model">microsoft.storage.location</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

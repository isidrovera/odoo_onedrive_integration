<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_microsoft_guest_list" model="ir.ui.view">
        <field name="name">microsoft.guest.list</field>
        <field name="model">microsoft.guest</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'accepted'" decoration-warning="state == 'pending'" decoration-danger="state in ('blocked', 'error')">
                <field name="display_name"/>
                <field name="email"/>
                <field name="user_id"/>
                <field name="tenant_id"/>
                <field name="state" widget="badge"/>
                <field name="group_ids" widget="many2many_tags"/>
                <field name="last_sync"/>
            </list>
        </field>
    </record>

    <record id="view_microsoft_guest_form" model="ir.ui.view">
        <field name="name">microsoft.guest.form</field>
        <field name="model">microsoft.guest</field>
        <field name="arch" type="xml">
            <form string="Invitado Microsoft">
                <header>
                    <button name="action_invite" type="object" string="Registrar / invitar" class="btn-primary" invisible="state == 'accepted'"/>
                    <button name="action_sync" type="object" string="Comprobar estado" class="btn-secondary" invisible="not entra_user_id"/>
                    <button name="action_apply_groups" type="object" string="Aplicar grupos" class="btn-secondary" invisible="not entra_user_id"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,pending,accepted,blocked,error"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="display_name"/></h1></div>
                    <group>
                        <group string="Usuario">
                            <field name="tenant_id" readonly="entra_user_id"/>
                            <field name="user_id"/>
                            <field name="email" readonly="entra_user_id"/>
                            <field name="entra_user_id" readonly="1"/>
                            <field name="user_principal_name" readonly="1"/>
                        </group>
                        <group string="Estado">
                            <field name="account_enabled" readonly="1"/>
                            <field name="invitation_date" readonly="1"/>
                            <field name="accepted_date" readonly="1"/>
                            <field name="last_sync" readonly="1"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Grupos">
                            <group>
                                <field name="group_ids" widget="many2many_tags" domain="[('tenant_id', '=', tenant_id)]"/>
                                <field name="owner_group_ids" widget="many2many_tags" domain="[('tenant_id', '=', tenant_id), ('group_type', '=', 'microsoft365')]"/>
                            </group>
                        </page>
                        <page string="Errores"><field name="last_error" readonly="1"/></page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_microsoft_guests" model="ir.actions.act_window">
        <field name="name">Usuarios invitados</field>
        <field name="res_model">microsoft.guest</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_microsoft_connection_list" model="ir.ui.view">
        <field name="name">microsoft.user.connection.list</field>
        <field name="model">microsoft.user.connection</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" decoration-success="state == 'connected'" decoration-danger="state == 'error'">
                <field name="user_id"/>
                <field name="tenant_id"/>
                <field name="email"/>
                <field name="state" widget="badge"/>
                <field name="last_connected"/>
                <button name="action_connect" type="object" string="Conectar" icon="fa-plug"/>
            </list>
        </field>
    </record>

    <record id="action_microsoft_my_connections" model="ir.actions.act_window">
        <field name="name">Mi conexión Microsoft</field>
        <field name="res_model">microsoft.user.connection</field>
        <field name="view_mode">list</field>
        <field name="domain">[('user_id', '=', uid)]</field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_microsoft_tenant_list" model="ir.ui.view">
        <field name="name">microsoft.tenant.list</field>
        <field name="model">onedrive.account</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <list string="Tenants Microsoft 365" decoration-success="token_status == 'connected'" decoration-warning="token_status == 'expired'" decoration-muted="not active">
                <field name="name"/>
                <field name="tenant_id" optional="show"/>
                <field name="sharepoint_root_url" widget="url" optional="show"/>
                <field name="token_status" widget="badge"/>
                <field name="last_sync" optional="show"/>
                <field name="active" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_microsoft_tenant_form" model="ir.ui.view">
        <field name="name">microsoft.tenant.form</field>
        <field name="model">onedrive.account</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <form string="Tenant Microsoft 365">
                <header>
                    <button name="action_test_application" type="object" string="Probar aplicación" class="btn-primary"/>
                    <button name="action_create_onedrive_location" type="object" string="Preparar OneDrive" class="btn-secondary"/>
                    <button name="action_connect_onedrive" type="object" string="Conectar cuenta delegada" class="btn-secondary"/>
                    <button name="action_sync_directory" type="object" string="Sincronizar grupos y sitios" class="btn-secondary"/>
                    <button name="action_clear_tokens" type="object" string="Revocar tokens" class="btn-secondary" confirm="¿Eliminar los tokens guardados para este tenant? Será necesario volver a autenticar las conexiones afectadas."/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Empresa Microsoft 365"/></h1>
                    </div>
                    <group>
                        <group string="Aplicación Microsoft Entra">
                            <field name="tenant_id" password="True"/>
                            <field name="client_id" password="True"/>
                            <field name="client_secret" password="True"/>
                            <field name="redirect_uri" readonly="1" widget="url"/>
                        </group>
                        <group string="SharePoint y conexiones">
                            <field name="sharepoint_root_url" widget="url" placeholder="https://empresa.sharepoint.com"/>
                            <field name="invite_redirect_url" widget="url" placeholder="https://odoo.empresa.com/web"/>
                            <field name="token_status" widget="badge"/>
                            <field name="last_sync" readonly="1"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Diagnóstico">
                            <group>
                                <group string="Estado">
                                    <field name="is_connected" readonly="1"/>
                                    <field name="token_status" readonly="1"/>
                                    <field name="last_sync" readonly="1"/>
                                </group>
                                <group string="Vencimiento de credenciales">
                                    <field name="token_expiry" readonly="1"/>
                                    <field name="app_token_expiry" readonly="1"/>
                                    <field name="sharepoint_token_expiry" readonly="1"/>
                                </group>
                            </group>
                            <group string="Último error">
                                <field name="last_error" readonly="1" nolabel="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_microsoft_tenants" model="ir.actions.act_window">
        <field name="name">Tenants Microsoft</field>
        <field name="res_model">onedrive.account</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

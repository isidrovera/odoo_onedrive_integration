<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_microsoft_tenant_list" model="ir.ui.view">
        <field name="name">microsoft.tenant.list</field>
        <field name="model">onedrive.account</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <list decoration-success="token_status == 'connected'" decoration-warning="token_status == 'expired'">
                <field name="name"/>
                <field name="tenant_id"/>
                <field name="sharepoint_root_url"/>
                <field name="token_status" widget="badge"/>
                <field name="last_sync"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_microsoft_tenant_form" model="ir.ui.view">
        <field name="name">microsoft.tenant.form</field>
        <field name="model">onedrive.account</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <form string="Tenant Microsoft 365">
                <header>
                    <button name="action_test_application" type="object" string="Probar aplicación" class="btn-primary"/>
                    <button name="action_create_onedrive_location" type="object" string="Preparar OneDrive" class="btn-secondary"/>
                    <button name="action_connect_onedrive" type="object" string="Conectar cuenta delegada" class="btn-secondary"/>
                    <button name="action_sync_directory" type="object" string="Sincronizar grupos y sitios" class="btn-secondary"/>
                    <button name="action_clear_tokens" type="object" string="Revocar tokens" class="btn-secondary" confirm="¿Eliminar todos los tokens guardados para este tenant?"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="Empresa Microsoft 365"/></h1></div>
                    <group>
                        <group string="Aplicación Entra">
                            <field name="tenant_id" password="True"/>
                            <field name="client_id" password="True"/>
                            <field name="client_secret" password="True"/>
                            <field name="redirect_uri" readonly="1"/>
                        </group>
                        <group string="SharePoint">
                            <field name="sharepoint_root_url" placeholder="https://empresa.sharepoint.com"/>
                            <field name="invite_redirect_url" placeholder="https://odoo.empresa.com/web"/>
                            <field name="token_status" widget="badge"/>
                            <field name="last_sync"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Diagnóstico">
                            <group>
                                <field name="last_error" readonly="1"/>
                                <field name="token_expiry" readonly="1"/>
                                <field name="app_token_expiry" readonly="1"/>
                                <field name="sharepoint_token_expiry" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_microsoft_tenants" model="ir.actions.act_window">
        <field name="name">Tenants Microsoft</field>
        <field name="res_model">onedrive.account</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

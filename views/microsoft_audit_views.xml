<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_microsoft_audit_list" model="ir.ui.view">
        <field name="name">microsoft.audit.log.list</field>
        <field name="model">microsoft.audit.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" decoration-success="status == 'success'" decoration-danger="status == 'error'">
                <field name="create_date"/>
                <field name="user_id"/>
                <field name="operation" widget="badge"/>
                <field name="location_id"/>
                <field name="item_name"/>
                <field name="status" widget="badge"/>
                <field name="message" optional="show"/>
            </list>
        </field>
    </record>

    <record id="action_microsoft_audit" model="ir.actions.act_window">
        <field name="name">Auditoría Microsoft 365</field>
        <field name="res_model">microsoft.audit.log</field>
        <field name="view_mode">list</field>
    </record>
</odoo>

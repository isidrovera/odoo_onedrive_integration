<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="odoo_onedrive_integration.OneDriveApp">
    <div class="o_onedrive_app" t-ref="root"
         t-on-dragover="onDragOver"
         t-on-dragleave="onDragLeave"
         t-on-drop="onDrop">

        <t t-set="stats" t-value="getStats()"/>

        <!-- NAVEGACIÓN LATERAL -->
        <aside class="od_sidebar">
            <div class="od_brand">
                <span class="od_brand_mark"><i class="bi bi-microsoft"/></span>
                <div>
                    <strong>Microsoft 365</strong>
                    <small><span class="od_online_dot"/> Conectado</small>
                </div>
            </div>
            <nav class="od_nav">
                <div class="od_nav_label">Documentos</div>
                <button class="od_nav_item"><i class="bi bi-house-door"/><span>Inicio</span></button>
                <button class="od_nav_item active"><i class="bi bi-folder2-open"/><span>Mis documentos</span></button>
                <button class="od_nav_item"><i class="bi bi-share"/><span>Compartidos</span></button>
                <button class="od_nav_item"><i class="bi bi-clock-history"/><span>Recientes</span></button>
                <button class="od_nav_item"><i class="bi bi-star"/><span>Favoritos</span></button>
            </nav>
            <div class="od_spaces">
                <div class="od_nav_label">Ubicación actual</div>
                <div class="od_sidebar_location">
                    <i class="bi bi-building"/>
                    <span t-esc="(state.currentLocation and state.currentLocation.name) or 'Sin ubicación'"/>
                </div>
                <small t-if="state.currentLocation">
                    <i class="bi bi-shield-check"/>
                    <t t-if="canManage()">Administrador</t>
                    <t t-elif="canEdit()">Puede editar</t>
                    <t t-else="">Solo lectura</t>
                </small>
            </div>
        </aside>

        <main class="od_workspace">
            <!-- CABECERA -->
            <header class="od_modern_header">
                <div class="od_title_block">
                    <h1>Documentos</h1>
                    <div class="od_header_path">Microsoft 365 <i class="bi bi-chevron-right"/> <t t-esc="getCurrentPath()"/></div>
                </div>
                <div class="od_header_tools">
                    <div class="od_searchbox">
                        <i class="bi bi-search"/>
                        <input type="text" t-att-value="state.search" t-on-input="onSearchInput"
                               t-on-keydown="onSearchSubmit" placeholder="Buscar documentos..."/>
                        <button t-if="state.search" class="btn" t-on-click="() => this.clearSearch()"><i class="bi bi-x-lg"/></button>
                    </div>
                    <button class="od_icon_button" t-on-click="() => this.refresh()" title="Actualizar"><i class="bi bi-arrow-clockwise"/></button>
                </div>
            </header>

            <!-- ACCIONES Y UBICACIÓN -->
            <div class="od_commandbar">
                <div class="od_location_selector">
                    <i class="bi bi-cloud-check"/>
                    <select class="form-select" t-on-change="onLocationChange" t-att-value="state.locationId or ''">
                        <t t-foreach="state.locations" t-as="location" t-key="location.id">
                            <option t-att-value="location.id" t-att-selected="location.id === state.locationId"><t t-esc="location.name"/></option>
                        </t>
                    </select>
                </div>
                <div class="od_toolbar_actions">
                    <t t-if="!selectorMode and canEdit()">
                        <button class="btn od_btn_new" t-on-click="() => this.createFolder()"><i class="bi bi-plus-lg"/> Nueva carpeta</button>
                        <button class="btn od_btn_upload" t-on-click="() => this.triggerUpload()"><i class="bi bi-cloud-arrow-up"/> Subir</button>
                        <input type="file" t-ref="fileInput" multiple="multiple" style="display:none;" t-on-change="uploadFile"/>
                    </t>
                    <t t-if="state.selected.size > 0">
                        <span class="od_selcount"><i class="bi bi-check-circle-fill"/> <t t-esc="state.selected.size"/> seleccionados</span>
                        <button t-if="!selectorMode and canManage()" class="btn btn-danger" t-on-click="() => this.deleteSelected()"><i class="bi bi-trash"/> Eliminar</button>
                    </t>
                    <div class="od_viewswitch">
                        <button class="btn" t-att-class="{'active': state.view === 'list'}" t-on-click="() => this.setView('list')" title="Lista"><i class="bi bi-list-ul"/></button>
                        <button class="btn" t-att-class="{'active': state.view === 'grid'}" t-on-click="() => this.setView('grid')" title="Cuadrícula"><i class="bi bi-grid"/></button>
                    </div>
                </div>
            </div>

            <!-- RESUMEN -->
            <section class="od_stats">
                <article class="od_stat_card blue"><span class="od_stat_icon"><i class="bi bi-file-earmark-text"/></span><div><small>Archivos</small><strong t-esc="stats.files"/><span>En esta carpeta</span></div></article>
                <article class="od_stat_card amber"><span class="od_stat_icon"><i class="bi bi-folder"/></span><div><small>Carpetas</small><strong t-esc="stats.folders"/><span>En esta carpeta</span></div></article>
                <article class="od_stat_card violet"><span class="od_stat_icon"><i class="bi bi-database"/></span><div><small>Tamaño visible</small><strong t-esc="formatBytes(stats.totalSize)"/><span>Solo archivos actuales</span></div></article>
                <article class="od_stat_card green"><span class="od_stat_icon"><i class="bi bi-clock"/></span><div><small>Modificados hoy</small><strong t-esc="stats.modifiedToday"/><span>Últimas 24 horas</span></div></article>
            </section>

            <!-- RUTA -->
            <div class="od_breadcrumb">
                <button t-if="state.path.length > 0" class="od_back_button" t-on-click="() => this.goUp()" title="Subir"><i class="bi bi-arrow-left"/></button>
                <span class="od_crumb" t-on-click="() => this.goRoot()"><i class="bi bi-house-door"/> <t t-esc="(state.currentLocation and state.currentLocation.name) or 'Ubicación'"/></span>
                <t t-foreach="state.path" t-as="p" t-key="p.id">
                    <i class="bi bi-chevron-right od_crumb_sep"/>
                    <span class="od_crumb" t-on-click="() => this.goTo(p_index)"><t t-esc="p.name"/></span>
                </t>
                <span t-if="state.searching" class="od_searchbadge"><i class="bi bi-search"/> Resultados para “<t t-esc="state.search"/>”</span>
            </div>

            <!-- PROGRESO -->
            <div t-if="state.uploadProgress" class="od_uploadbar">
            <div class="od_uploadbar_info">
                <i class="bi bi-cloud-upload"/>
                Subiendo: <strong><t t-esc="state.uploadProgress.name"/></strong>
                <span><t t-esc="state.uploadProgress.percent"/>%</span>
            </div>
            <div class="od_progress">
                <div class="od_progress_bar"
                     t-att-style="`width: ${state.uploadProgress.percent}%`"/>
            </div>
            </div>

            <div t-if="state.dragOver and !selectorMode" class="od_dropoverlay">
            <div class="od_dropmsg">
                <i class="bi bi-cloud-upload-fill"/>
                <h2>Suelta los archivos aquí</h2>
                <p>Se subirán a la carpeta actual</p>
            </div>
            </div>

            <div t-if="state.loading" class="od_loading">
            <div class="od_spinner"/>
            <p>Cargando archivos...</p>
            </div>

            <div t-if="!state.loading and state.locations.length === 0" class="od_empty">
            <i class="bi bi-shield-lock"/>
            <h3>No tienes ubicaciones documentales asignadas</h3>
            <p>Solicita acceso al administrador Microsoft 365.</p>
            </div>
            <div t-elif="!state.loading and state.filteredFiles.length === 0" class="od_empty">
            <i class="bi bi-folder2-open"/>
            <h3 t-if="state.searching">No hay resultados para "<t t-esc="state.search"/>"</h3>
            <h3 t-else="">Esta carpeta está vacía</h3>
            <p t-if="!selectorMode">Arrastra archivos aquí o haz clic en Subir</p>
            </div>

            <div class="od_content_shell" t-if="!state.loading and state.filteredFiles.length > 0">
                <section class="od_files_panel">

        <div t-if="state.view === 'grid'"
             class="od_grid">
            <t t-foreach="state.filteredFiles" t-as="file" t-key="file.id">
                <t t-set="ic" t-value="getFileIcon(file)"/>
                <div class="od_card"
                     t-att-class="{'selected': isSelected(file)}"
                     t-on-click="(ev) => this.selectForDetails(file, ev)"
                     t-on-dblclick="() => this.openFolder(file)"
                     t-on-contextmenu="(ev) => this.openCtxMenu(file, ev)">

                    <div class="od_card_check" t-on-click.stop="(ev) => this.toggleSelect(file, ev)">
                        <i t-att-class="isSelected(file) ? 'bi bi-check-square-fill' : 'bi bi-square'"/>
                    </div>

                    <div class="od_card_thumb" t-on-click="() => this.openFolder(file)">
                        <div class="od_card_icon" t-att-style="`color:${ic.color};`">
                            <i t-att-class="`bi ${ic.icon}`"/>
                        </div>
                    </div>

                    <div class="od_card_body">
                        <div class="od_card_name" t-att-title="file.name">
                            <t t-esc="file.name"/>
                        </div>
                        <div class="od_card_meta">
                            <t t-if="file.folder">
                                <t t-esc="(file.folder and file.folder.childCount) or 0"/> elementos
                            </t>
                            <t t-else="">
                                <t t-esc="formatBytes(file.size)"/>
                            </t>
                            ·
                            <t t-esc="formatDate(file.lastModifiedDateTime)"/>
                        </div>
                        <div class="od_card_author"><span class="od_avatar"><t t-esc="getModifierInitials(file)"/></span><t t-esc="getModifiedBy(file)"/></div>
                    </div>

                    <div t-if="!selectorMode" class="od_card_actions">
                        <button class="btn" t-on-click.stop="() => this.previewFile(file)" title="Vista previa">
                            <i class="bi bi-eye"/>
                        </button>
                        <button t-if="!file.folder" class="btn" t-on-click.stop="() => this.downloadItem(file)" title="Descargar">
                            <i class="bi bi-download"/>
                        </button>
                        <button class="btn" t-on-click.stop="(ev) => this.openCtxMenu(file, ev)" title="Más">
                            <i class="bi bi-three-dots-vertical"/>
                        </button>
                    </div>
                </div>
            </t>
        </div>

        <div t-if="state.view === 'list'"
             class="od_list">
            <div class="od_list_header">
                <div class="od_col_check">
                    <i t-att-class="state.selected.size === state.filteredFiles.length ? 'bi bi-check-square-fill' : 'bi bi-square'"
                       t-on-click="() => this.selectAll()"/>
                </div>
                <div class="od_col_name sortable" t-on-click="() => this.setSort('name')">
                    Nombre
                    <i t-if="state.sortBy === 'name'"
                       t-att-class="`bi bi-caret-${state.sortDir === 'asc' ? 'up' : 'down'}-fill`"/>
                </div>
                <div class="od_col_author">Modificado por</div>
                <div class="od_col_modified sortable" t-on-click="() => this.setSort('modified')">
                    Última modificación
                    <i t-if="state.sortBy === 'modified'"
                       t-att-class="`bi bi-caret-${state.sortDir === 'asc' ? 'up' : 'down'}-fill`"/>
                </div>
                <div class="od_col_size sortable" t-on-click="() => this.setSort('size')">
                    Tamaño
                    <i t-if="state.sortBy === 'size'"
                       t-att-class="`bi bi-caret-${state.sortDir === 'asc' ? 'up' : 'down'}-fill`"/>
                </div>
                <div class="od_col_actions"/>
            </div>
            <t t-foreach="state.filteredFiles" t-as="file" t-key="file.id">
                <t t-set="ic" t-value="getFileIcon(file)"/>
                <div class="od_list_row"
                     t-att-class="{'selected': isSelected(file)}"
                     t-on-click="(ev) => this.selectForDetails(file, ev)"
                     t-on-dblclick="() => this.openFolder(file)"
                     t-on-contextmenu="(ev) => this.openCtxMenu(file, ev)">
                    <div class="od_col_check" t-on-click.stop="(ev) => this.toggleSelect(file, ev)">
                        <i t-att-class="isSelected(file) ? 'bi bi-check-square-fill' : 'bi bi-square'"/>
                    </div>
                    <div class="od_col_name" t-on-click="() => this.openFolder(file)">
                        <i t-att-class="`bi ${ic.icon} od_listicon`" t-att-style="`color:${ic.color};`"/>
                        <span class="od_listname"><t t-esc="file.name"/></span>
                    </div>
                    <div class="od_col_author"><span class="od_avatar"><t t-esc="getModifierInitials(file)"/></span><span t-esc="getModifiedBy(file)"/></div>
                    <div class="od_col_modified"><strong t-esc="formatRelativeDate(file.lastModifiedDateTime)"/><small t-esc="formatDate(file.lastModifiedDateTime)"/></div>
                    <div class="od_col_size">
                        <t t-if="file.folder">—</t>
                        <t t-else=""><t t-esc="formatBytes(file.size)"/></t>
                    </div>
                    <div t-if="!selectorMode" class="od_col_actions">
                        <button class="btn" t-on-click.stop="() => this.previewFile(file)" title="Vista previa">
                            <i class="bi bi-eye"/>
                        </button>
                        <button class="btn" t-on-click.stop="() => this.downloadItem(file)" title="Descargar">
                            <i class="bi bi-download"/>
                        </button>
                        <button t-if="canManage()" class="btn" t-on-click.stop="() => this.shareItem(file)" title="Compartir">
                            <i class="bi bi-share"/>
                        </button>
                        <button class="btn" t-on-click.stop="(ev) => this.openCtxMenu(file, ev)" title="Más">
                            <i class="bi bi-three-dots-vertical"/>
                        </button>
                    </div>
                </div>
            </t>
        </div>

                </section>

                <!-- PANEL DE DETALLES -->
                <aside t-if="state.detailFile" class="od_details_panel">
                    <div class="od_details_header">
                        <div><small>Detalles</small><h3 t-esc="state.detailFile.name"/></div>
                        <button class="od_icon_button" t-on-click="() => this.closeDetails()"><i class="bi bi-x-lg"/></button>
                    </div>
                    <div class="od_details_preview">
                        <t t-set="detailIcon" t-value="getFileIcon(state.detailFile)"/>
                        <i t-att-class="`bi ${detailIcon.icon}`" t-att-style="`color:${detailIcon.color};`"/>
                    </div>
                    <div class="od_details_tabs"><span class="active">Detalles</span><span>Actividad</span></div>
                    <dl class="od_details_list">
                        <div><dt>Modificado por</dt><dd><span class="od_avatar"><t t-esc="getModifierInitials(state.detailFile)"/></span><t t-esc="getModifiedBy(state.detailFile)"/></dd></div>
                        <div><dt>Última modificación</dt><dd><strong t-esc="formatRelativeDate(state.detailFile.lastModifiedDateTime)"/><small t-esc="formatDate(state.detailFile.lastModifiedDateTime)"/></dd></div>
                        <div><dt>Ubicación</dt><dd><i class="bi bi-folder2"/><t t-esc="getCurrentPath()"/></dd></div>
                        <div><dt>Tipo</dt><dd t-if="state.detailFile.folder">Carpeta</dd><dd t-else=""><t t-esc="(state.detailFile.file and state.detailFile.file.mimeType) or 'Archivo'"/></dd></div>
                        <div t-if="!state.detailFile.folder"><dt>Tamaño</dt><dd t-esc="formatBytes(state.detailFile.size)"/></div>
                    </dl>
                    <div class="od_details_actions">
                        <button t-if="!state.detailFile.folder" class="btn btn-primary" t-on-click="() => this.openExternal(state.detailFile)"><i class="bi bi-box-arrow-up-right"/> Abrir</button>
                        <button class="btn btn-light" t-on-click="() => this.showProperties(state.detailFile)"><i class="bi bi-info-circle"/> Propiedades</button>
                    </div>
                </aside>
            </div>
        </main>

        <!-- CONTEXT MENU -->
        <div t-if="state.ctxMenu.open" class="od_ctxmenu"
             t-att-style="`top:${state.ctxMenu.y}px; left:${state.ctxMenu.x}px;`">
            <button class="btn" t-on-click="() => this.previewFile(state.ctxMenu.file)">
                <i class="bi bi-eye"/> Vista previa
            </button>
            <button t-if="!selectorMode and !state.ctxMenu.file.folder" class="btn" t-on-click="() => this.downloadItem(state.ctxMenu.file)">
                <i class="bi bi-download"/> Descargar
            </button>
            <button t-if="!selectorMode and canManage()" class="btn" t-on-click="() => this.shareItem(state.ctxMenu.file)">
                <i class="bi bi-share"/> Compartir
            </button>
            <t t-if="!selectorMode and canEdit()">
                <div class="od_ctxsep"/>
                <button class="btn" t-on-click="() => this.renameItem(state.ctxMenu.file)">
                    <i class="bi bi-pencil"/> Renombrar
                </button>
            </t>
            <button class="btn" t-on-click="() => this.showProperties(state.ctxMenu.file)">
                <i class="bi bi-info-circle"/> Propiedades
            </button>
            <t t-if="!selectorMode and canManage()">
                <div class="od_ctxsep"/>
                <button class="btn danger" t-on-click="() => this.deleteItem(state.ctxMenu.file)">
                    <i class="bi bi-trash"/> Eliminar
                </button>
            </t>
        </div>
    </div>
</t>


<!-- ============== CONFIRM DIALOG ============== -->
<t t-name="odoo_onedrive_integration.ConfirmDialog">
    <Dialog title="props.title or 'Confirmar'" size="'md'" contentClass="'od_dialog'">
        <div class="od_dialog_body">
            <div class="od_dialog_icon" t-att-class="{'danger': props.danger}">
                <i t-att-class="`bi ${props.icon || 'bi-question-circle'}`"/>
            </div>
            <div class="od_dialog_text">
                <h4><t t-esc="props.message"/></h4>
                <p t-if="props.description"><t t-esc="props.description"/></p>
            </div>
        </div>
        <t t-set-slot="footer">
            <button class="btn btn-light" t-on-click="() => this.cancel()">
                <t t-esc="props.cancelLabel or 'Cancelar'"/>
            </button>
            <button t-att-class="props.danger ? 'btn btn-danger' : 'btn btn-primary'"
                    t-on-click="() => this.confirm()">
                <t t-esc="props.confirmLabel or 'Confirmar'"/>
            </button>
        </t>
    </Dialog>
</t>


<!-- ============== PROMPT DIALOG ============== -->
<t t-name="odoo_onedrive_integration.PromptDialog">
    <Dialog title="props.title" size="'md'" contentClass="'od_dialog'">
        <div class="od_dialog_body">
            <div class="od_dialog_icon">
                <i t-att-class="`bi ${props.icon || 'bi-pencil'}`"/>
            </div>
            <div class="od_dialog_text" style="flex:1;">
                <label t-if="props.label" class="od_label"><t t-esc="props.label"/></label>
                <input type="text" class="form-control"
                       t-ref="input"
                       t-att-value="state.value"
                       t-att-placeholder="props.placeholder || ''"
                       t-on-input="(ev) => state.value = ev.target.value"
                       t-on-keydown="onKeyDown"/>
            </div>
        </div>
        <t t-set-slot="footer">
            <button class="btn btn-light" t-on-click="() => this.cancel()">Cancelar</button>
            <button class="btn btn-primary" t-on-click="() => this.confirm()">
                <t t-esc="props.confirmLabel or 'Aceptar'"/>
            </button>
        </t>
    </Dialog>
</t>


<!-- ============== FILE PREVIEW DIALOG ============== -->
<t t-name="odoo_onedrive_integration.FilePreviewDialog">
    <Dialog title="props.file.name" size="'xl'" contentClass="'od_preview_dialog'">
        <div class="od_preview_body">
            <div t-if="state.loading" class="od_preview_loading">
                <div class="od_spinner"/>
                <p>Cargando vista previa...</p>
            </div>
            <div t-elif="state.error" class="od_preview_error">
                <i t-att-class="`bi ${icon.icon}`" t-att-style="`color:${icon.color};`"/>
                <h3><t t-esc="state.error"/></h3>
                <p>Descarga el archivo para verlo</p>
            </div>
            <div t-else="" class="od_preview_content">
                <iframe t-att-src="state.previewUrl" frameborder="0" allowfullscreen="allowfullscreen"/>
            </div>

            <div class="od_preview_info">
                <div class="od_info_block">
                    <i t-att-class="`bi ${icon.icon}`" t-att-style="`color:${icon.color};`"/>
                    <div>
                        <div class="od_info_name"><t t-esc="props.file.name"/></div>
                        <div class="od_info_meta">
                            <span t-if="props.file.size"><t t-esc="formatBytes(props.file.size)"/> · </span>
                            <span><t t-esc="formatDate(props.file.lastModifiedDateTime)"/></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <t t-set-slot="footer">
            <button t-if="props.onDelete" class="btn btn-danger" t-on-click="() => this.remove()">
                <i class="bi bi-trash"/> Eliminar
            </button>
            <button t-if="props.onShare" class="btn btn-light" t-on-click="() => this.share()">
                <i class="bi bi-share"/> Compartir
            </button>
            <button class="btn btn-primary" t-on-click="() => this.download()">
                <i class="bi bi-download"/> Descargar
            </button>
            <button t-if="props.onOpenExternal" class="btn btn-primary" t-on-click="() => this.openExternal()">
                <i class="bi bi-box-arrow-up-right"/> Abrir en Microsoft 365
            </button>
        </t>
    </Dialog>
</t>


<!-- ============== SHARE DIALOG ============== -->
<t t-name="odoo_onedrive_integration.ShareDialog">
    <Dialog title="'Compartir archivo'" size="'md'" contentClass="'od_dialog'">
        <div class="od_share_body">
            <h4><i class="bi bi-share-fill"/> <t t-esc="props.file.name"/></h4>

            <label class="od_label">Permisos</label>
            <div class="od_radio_group">
                <label class="od_radio">
                    <input type="radio" name="stype" value="view"
                           t-att-checked="state.shareType === 'view'"
                           t-on-change="() => state.shareType = 'view'"/>
                    <span><i class="bi bi-eye"/> Solo lectura</span>
                </label>
                <label class="od_radio">
                    <input type="radio" name="stype" value="edit"
                           t-att-checked="state.shareType === 'edit'"
                           t-on-change="() => state.shareType = 'edit'"/>
                    <span><i class="bi bi-pencil"/> Edición</span>
                </label>
            </div>

            <label class="od_label">Acceso</label>
            <div class="od_radio_group">
                <label class="od_radio">
                    <input type="radio" name="scope" value="anonymous"
                           t-att-checked="state.scope === 'anonymous'"
                           t-on-change="() => state.scope = 'anonymous'"/>
                    <span><i class="bi bi-globe"/> Cualquiera con el enlace (no recomendado)</span>
                </label>
                <label class="od_radio">
                    <input type="radio" name="scope" value="organization"
                           t-att-checked="state.scope === 'organization'"
                           t-on-change="() => state.scope = 'organization'"/>
                    <span><i class="bi bi-building"/> Solo mi organización</span>
                </label>
            </div>

            <div t-if="state.link" class="od_link_box">
                <input type="text" readonly="readonly" t-att-value="state.link"/>
                <button class="btn btn-primary btn-sm" t-on-click="() => this.copyLink()">
                    <i class="bi bi-clipboard"/> Copiar
                </button>
            </div>
        </div>
        <t t-set-slot="footer">
            <button class="btn btn-light" t-on-click="() => this.closeDialog()">Cerrar</button>
            <button class="btn btn-primary"
                    t-att-disabled="state.loading"
                    t-on-click="() => this.generate()">
                <i class="bi bi-link-45deg"/>
                <t t-if="state.loading"> Generando...</t>
                <t t-else=""> Generar enlace</t>
            </button>
        </t>
    </Dialog>
</t>


<!-- ============== PROPERTIES DIALOG ============== -->
<t t-name="odoo_onedrive_integration.PropertiesDialog">
    <Dialog title="'Propiedades'" size="'md'" contentClass="'od_dialog'">
        <div class="od_props_body">
            <div class="od_props_header">
                <i t-att-class="`bi ${icon.icon}`" t-att-style="`color:${icon.color};`"/>
                <h4><t t-esc="props.file.name"/></h4>
            </div>
            <table class="od_props_table">
                <tr>
                    <th>Tipo</th>
                    <td t-if="props.file.folder">Carpeta</td>
                    <td t-else=""><t t-esc="(props.file.file and props.file.file.mimeType) or 'Archivo'"/></td>
                </tr>
                <tr t-if="!props.file.folder">
                    <th>Tamaño</th>
                    <td><t t-esc="formatBytes(props.file.size)"/></td>
                </tr>
                <tr t-if="props.file.folder">
                    <th>Elementos</th>
                    <td><t t-esc="(props.file.folder and props.file.folder.childCount) or 0"/></td>
                </tr>
                <tr>
                    <th>Creado</th>
                    <td><t t-esc="formatDate(props.file.createdDateTime)"/></td>
                </tr>
                <tr>
                    <th>Modificado</th>
                    <td><t t-esc="formatDate(props.file.lastModifiedDateTime)"/></td>
                </tr>
                <tr t-if="props.file.webUrl">
                    <th>URL</th>
                    <td><a t-att-href="props.file.webUrl" target="_blank">Abrir en Microsoft 365</a></td>
                </tr>
            </table>
        </div>
        <t t-set-slot="footer">
            <button class="btn btn-primary" t-on-click="() => this.closeDialog()">Cerrar</button>
        </t>
    </Dialog>
</t>

</templates>
